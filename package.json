{
  "name": "turncloak",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "vite build --mode singlefile && node scripts/preview-fragment.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "sync:engine": "node scripts/sync-engine.mjs",
    "native:assets": "node scripts/render-icons.cjs && capacitor-assets generate --ios --android --iconBackgroundColor '#0b0708' --iconBackgroundColorDark '#0b0708' --splashBackgroundColor '#0b0708' --splashBackgroundColorDark '#0b0708'",
    "native:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.118.0",
    "qrcode-generator": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
